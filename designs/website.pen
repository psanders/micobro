                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "RqiRm",
                      "name": "H",
                      "fill": "$ui:brand.ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "7. Borrar tus datos",
                      "fontFamily": "$ui:font-family",
                      "fontSize": 22,
                      "fontWeight": "800"
                    },
                    {
                      "type": "text",
                      "id": "O2Heo",
                      "name": "P",
                      "fill": "$ui:brand.ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Desde la app: Mi cuenta → Eliminar mis datos borra todo lo guardado en el teléfono y desconecta Google. La hoja «Micobro / Datos» es tuya y queda en tu Drive; puedes borrarla desde Google Drive. Más detalles en micobro.app/eliminar-datos.",
                      "lineHeight": 1.65,
                      "fontFamily": "$ui:font-family",
                      "fontSize": 16,
                      "fontWeight": "500"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Oubyk",
                  "name": "8. Seguridad",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "NpgbV",
                      "name": "H",
